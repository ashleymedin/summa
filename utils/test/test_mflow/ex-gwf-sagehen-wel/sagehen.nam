# GWF model name file for model SAGEHEN: ex-gwf-sagehen with one pumping well.
# Every other file is a link into ../ex-gwf-sagehen, so the two stay the same model.
BEGIN OPTIONS
  NEWTON  UNDER_RELAXATION
  SAVE_FLOWS
END OPTIONS

BEGIN PACKAGES
  DIS6   sagehen.dis   dis
  IC6    sagehen.ic    ic
  NPF6   sagehen.npf   npf
  STO6   sagehen.sto   sto
  UZF6   sagehen.uzf   UZF
  RCH6   sagehen.rcha  RCHA
  CHD6   sagehen.chd   chd
  DRN6   sagehen.drn   DRN
  WEL6   sagehen.wel   WEL
  OC6    sagehen.oc    oc
END PACKAGES
