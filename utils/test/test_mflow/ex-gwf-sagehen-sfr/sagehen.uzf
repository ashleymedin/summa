# Unsaturated zone below SUMMA's soil column, written by tools/build_sagehen_uzf.py.
# The coupler overwrites SINF_PVAR (m s-1) each step with SUMMA's drainage where the water table is
# below the cell top, and returns REJINF to the soil column; the period FINF here is only a placeholder.
# THTI carries the long-term mean recharge, 116 mm a year, at each cell's VKS.
BEGIN OPTIONS
  SAVE_FLOWS
END OPTIONS

BEGIN DIMENSIONS
  NUZFCELLS  3387
  NTRAILWAVES  3
  NWAVESETS  1000
END DIMENSIONS

