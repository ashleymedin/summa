# Time discretisation - SECONDS, one stress period of 744 hourly steps.
# The coupler advances MODFLOW exactly once per SUMMA data step, so the number
# of steps here (744) must be >= the number of SUMMA data steps (numtim) and
# perlen/nstp must equal the SUMMA data_step (3600 s).
#   744 steps * 3600 s = 2678400 s  (1980-01-01 00:00 .. 1980-01-31 23:00, hourly)
BEGIN OPTIONS
  TIME_UNITS  SECONDS
END OPTIONS

BEGIN DIMENSIONS
  NPER  1
END DIMENSIONS

BEGIN PERIODDATA
#  perlen      nstp   tsmult
   2678400.0   744    1.0
END PERIODDATA
