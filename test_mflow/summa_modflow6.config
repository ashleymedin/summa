&coupler
  mf6_model_name   = 'SAGEHEN'      ! GWF model name in mfsim.nam
  rch_package_name = 'RCHA'         ! RCH package name in sagehen.nam (default 'RCHA', line optional)
  map_file         = 'hru_map.txt'  ! explicit HRU -> cell map (see note below)
  feedback         = .true.         ! false is one-way, only sends SUMMA drainage to MODFLOW RCH
                                    ! true is two-way, also push MODFLOW head back as SUMMA's lower BC
/

! This domain has a single SUMMA HRU (the whole Sagehen basin) given in lon/lat,
! while the MODFLOW grid is in projected metres, so the built-in nearest-cell
! matcher is not meaningful here - hru_map.txt pins the HRU to one active cell.
